# ── TREMOR Configuration ──────────────────────────────────────────────
# Copy to .env and customize. All values have sane defaults.

# ── Ingestion ─────────────────────────────────────────────────────────
LOG_PATHS=./sample/app.log
TAIL_START=end                    # end | beginning (beginning for replay/eval)
POLL_INTERVAL_MS=150
LATENESS_S=5

# ── Windows & Baseline ───────────────────────────────────────────────
WINDOWS_S=10,60,300
WARMUP_SECONDS=300
MIN_EVENTS=20

# ── Severity Z-score Thresholds ──────────────────────────────────────
Z_INFO=2
Z_WARN=3
Z_HIGH=4
Z_CRIT=6
RATE_CEILING=0.5                  # Hard critical ceiling (50%)
CLEAR_Z=1.5                      # Hysteresis: clear below this z
CLEAR_WINDOWS=3                   # Consecutive clear windows to resolve

# ── Silence Detection ────────────────────────────────────────────────
SILENCE_SECONDS=30

# ── Alert Manager ────────────────────────────────────────────────────
ALERT_COOLDOWN_S=300

# ── AWS ──────────────────────────────────────────────────────────────
# AWS_ACCESS_KEY_ID=               # Use IAM roles in production
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
SNS_TOPIC_ARN=
CW_LOG_GROUP=/tremor/alerts
CW_LOG_STREAM=default
CW_NAMESPACE=Tremor
AWS_ENDPOINT_URL=                 # Set to http://localhost:4566 for LocalStack

# ── Modes ────────────────────────────────────────────────────────────
DRY_RUN=false
DEMO_MODE=false

# ── Database ─────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./tremor.db

# ── Server ───────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=*                    # Comma-separated origins; * for dev only

# ── Logging ──────────────────────────────────────────────────────────
LOG_LEVEL=INFO
